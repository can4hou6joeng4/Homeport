{
  // Homeport — bobochang.cn 个人主页(Cloudflare Workers 静态资产)
  "name": "homeport",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // www 与 apex 绑在同一个 Worker 上。Worker 按主机名把 www 301 到
    // https://bobochang.cn,其余请求交给静态资源。
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "bobochang.cn", "custom_domain": true },
    { "pattern": "www.bobochang.cn", "custom_domain": true }
  ]
}
